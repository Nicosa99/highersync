# Application
NODE_ENV=production
APP_NAME=HigherSync

# Ports
BACKEND_PORT=3012
FRONTEND_PORT=3013

# Database
DATABASE_URL=postgresql://highersync_user:YOUR_PASSWORD_HERE@localhost:5434/highersync

# JWT & Security
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# API URLs
NEXT_PUBLIC_API_URL=https://highersync.com/api
API_URL=http://localhost:3012

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@highersync.com

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_PATH=/root/highersync/uploads

# External Services (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Redis (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Monitoring & Logging (optional)
# SENTRY_DSN=
# LOG_LEVEL=info

# Development only (remove in production)
# DEBUG=true
